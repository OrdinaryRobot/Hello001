{
    "// ---- 编码与缩进 ----": "",
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    "// ---- C/C++ 默认工具链 ----": "",
    "C_Cpp.default.compilerPath": "D:/code/mingw64/bin/gcc.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.errorSquiggles": "enabled",

    "// ---- C/C++ Runner 扩展 ----": "",
    "C_Cpp_Runner.cCompilerPath": "D:/code/mingw64/bin/gcc.exe",
    "C_Cpp_Runner.cppCompilerPath": "D:/code/mingw64/bin/g++.exe",
    "C_Cpp_Runner.debuggerPath": "D:/code/mingw64/bin/gdb.exe",
    "C_Cpp_Runner.useMsvc": false,
    "C_Cpp_Runner.enableWarnings": true,
    "C_Cpp_Runner.warningsAsError": false,
    "C_Cpp_Runner.warnings": [
        "-Wall",
        "-Wextra"
    ],

    "// ---- 终端（UTF-8，防中文乱码）----": "",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "chcp 65001 > $null; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::InputEncoding = [System.Text.Encoding]::UTF8"
            ]
        }
    },

    "// ---- CMake ----": "",
    "cmake.sourceDirectory": "D:/code/C/Clearning"
}
